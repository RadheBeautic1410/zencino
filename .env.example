DATABASE_URL=postgresql://zencino:zencino@localhost:54329/zencino
# Optional direct connection for migrations and worker; derived for Neon if omitted.
DATABASE_URL_UNPOOLED=
APP_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000
CHECKOUT_ENABLED=false

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Optional in local development. Without these, email sends are logged by the worker.
# Works with any SMTP provider: Mailtrap, SendGrid, Postmark, AWS SES, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── Email Webhook ──────────────────────────────────────────────────────────────
# Optional. Set this to receive delivery events from your SMTP provider.
# Accepts Authorization: Bearer <secret> or x-webhook-secret header.
# EMAIL_WEBHOOK_SECRET=

# Image uploads: local (public/uploads) or firebase
STORAGE_LOCATION=local
# Required for firebase: bucket name only, without gs://
FIREBASE_STORAGE_BUCKET=
# Server-only service account, or use GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Quoted private key; escaped \n sequences are supported.
FIREBASE_PRIVATE_KEY=
